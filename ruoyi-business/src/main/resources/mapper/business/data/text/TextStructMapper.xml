<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.data.text.mapper.TextStructMapper">

    <resultMap type="com.ruoyi.business.data.text.domain.TextStruct" id="TextStructResult">
        <id property="id" column="id"/>
        <result property="taskName" column="task_name"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectTextStructVo">
        select id, task_name, status, create_by, create_time, update_by, update_time, remark from business_data_text
    </sql>

    <select id="selectTextStructList" parameterType="com.ruoyi.business.data.text.domain.TextStruct" resultMap="TextStructResult">
        <include refid="selectTextStructVo"/>
        <where>
            <if test="taskName != null and taskName != ''">and task_name like concat('%', #{taskName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectTextStructById" parameterType="Long" resultMap="TextStructResult">
        <include refid="selectTextStructVo"/>
        where id = #{id}
    </select>

    <insert id="insertTextStruct" parameterType="com.ruoyi.business.data.text.domain.TextStruct" useGeneratedKeys="true" keyProperty="id">
        insert into business_data_text
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateTextStruct" parameterType="com.ruoyi.business.data.text.domain.TextStruct">
        update business_data_text
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTextStructById" parameterType="Long">
        delete from business_data_text where id = #{id}
    </delete>

    <delete id="deleteTextStructByIds">
        delete from business_data_text where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>

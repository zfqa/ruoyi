<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.report.mapper.AiReportMapper">

    <resultMap type="com.ruoyi.business.report.domain.AiReport" id="AiReportResult">
        <id property="id" column="id"/>
        <result property="importTaskId" column="import_task_id"/>
        <result property="taskName" column="task_name"/>
        <result property="status" column="status"/>
        <result property="reportType" column="report_type"/>
        <result property="generationMode" column="generation_mode"/>
        <result property="reportContent" column="report_content"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectAiReportVo">
        select id, import_task_id, task_name, status, report_type, generation_mode,
               create_by, create_time, update_by, update_time, remark
        from business_report
    </sql>

    <sql id="selectAiReportDetailVo">
        select id, import_task_id, task_name, status, report_type, generation_mode, report_content,
               create_by, create_time, update_by, update_time, remark
        from business_report
    </sql>

    <select id="selectAiReportList" parameterType="com.ruoyi.business.report.domain.AiReport" resultMap="AiReportResult">
        <include refid="selectAiReportVo"/>
        <where>
            <if test="taskName != null and taskName != ''">and task_name like concat('%', #{taskName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="reportType != null and reportType != ''">and report_type = #{reportType}</if>
            <if test="importTaskId != null">and import_task_id = #{importTaskId}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectLatestAiReportByImportTaskId" parameterType="Long" resultMap="AiReportResult">
        <include refid="selectAiReportDetailVo"/>
        where import_task_id = #{importTaskId}
        order by id desc
        limit 1
    </select>

    <select id="selectAiReportById" parameterType="Long" resultMap="AiReportResult">
        <include refid="selectAiReportDetailVo"/>
        where id = #{id}
    </select>

    <insert id="insertAiReport" parameterType="com.ruoyi.business.report.domain.AiReport" useGeneratedKeys="true" keyProperty="id">
        insert into business_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="importTaskId != null">import_task_id,</if>
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="reportType != null and reportType != ''">report_type,</if>
            <if test="generationMode != null and generationMode != ''">generation_mode,</if>
            <if test="reportContent != null">report_content,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="importTaskId != null">#{importTaskId},</if>
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="reportType != null and reportType != ''">#{reportType},</if>
            <if test="generationMode != null and generationMode != ''">#{generationMode},</if>
            <if test="reportContent != null">#{reportContent},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiReport" parameterType="com.ruoyi.business.report.domain.AiReport">
        update business_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reportType != null and reportType != ''">report_type = #{reportType},</if>
            <if test="generationMode != null and generationMode != ''">generation_mode = #{generationMode},</if>
            <if test="reportContent != null">report_content = #{reportContent},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAiReportById" parameterType="Long">
        delete from business_report where id = #{id}
    </delete>

    <delete id="deleteAiReportByIds">
        delete from business_report where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.vehicle.mapper.VehicleModelMapper">
  <resultMap id="Model" type="com.ruoyi.business.vehicle.domain.VehicleModel">
    <id property="id" column="id"/><result property="sourceCode" column="source_code"/><result property="dongchediCarId" column="dongchedi_car_id"/><result property="dongchediSeriesId" column="dongchedi_series_id"/><result property="brandName" column="brand_name"/><result property="seriesName" column="series_name"/><result property="modelName" column="model_name"/><result property="manufacturer" column="manufacturer"/><result property="officialGuidePrice" column="official_guide_price"/><result property="level" column="level"/><result property="energyType" column="energy_type"/><result property="instrumentScreenSizeInch" column="instrument_screen_size_inch"/><result property="instrumentScreenStyle" column="instrument_screen_style"/><result property="centerScreenSizeInch" column="center_screen_size_inch"/><result property="centerScreenMaterial" column="center_screen_material"/><result property="passengerScreenSizeInch" column="passenger_screen_size_inch"/><result property="rearScreenSizeInch" column="rear_screen_size_inch"/><result property="sourceUrl" column="source_url"/><result property="fieldSourcesJson" column="field_sources_json"/><result property="fieldStatusJson" column="field_status_json"/><result property="rawJson" column="raw_json"/><result property="firstSeenTaskId" column="first_seen_task_id"/><result property="lastSeenTaskId" column="last_seen_task_id"/><result property="firstSeenTime" column="first_seen_time"/><result property="lastCrawledTime" column="last_crawled_time"/><result property="createBy" column="create_by"/><result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
  </resultMap>
  <sql id="columns">id,source_code,dongchedi_car_id,dongchedi_series_id,brand_name,series_name,model_name,manufacturer,official_guide_price,level,energy_type,instrument_screen_size_inch,instrument_screen_style,center_screen_size_inch,center_screen_material,passenger_screen_size_inch,rear_screen_size_inch,source_url,field_sources_json,field_status_json,raw_json,first_seen_task_id,last_seen_task_id,first_seen_time,last_crawled_time,create_by,create_time,update_by,update_time,remark</sql>
  <select id="selectList" resultMap="Model">select <include refid="columns"/> from business_vehicle_model <where><if test="brandName != null and brandName != ''">and brand_name like concat('%',#{brandName},'%')</if><if test="seriesName != null and seriesName != ''">and series_name like concat('%',#{seriesName},'%')</if><if test="modelName != null and modelName != ''">and model_name like concat('%',#{modelName},'%')</if><if test="manufacturer != null and manufacturer != ''">and manufacturer like concat('%',#{manufacturer},'%')</if><if test="energyType != null and energyType != ''">and energy_type=#{energyType}</if><if test="dongchediSeriesId != null and dongchediSeriesId != ''">and dongchedi_series_id=#{dongchediSeriesId}</if><if test="dongchediCarId != null and dongchediCarId != ''">and dongchedi_car_id=#{dongchediCarId}</if></where> order by last_crawled_time desc,id desc</select>
  <select id="selectById" resultMap="Model">select <include refid="columns"/> from business_vehicle_model where id=#{id}</select>
  <select id="selectBySourceCarId" resultMap="Model">select <include refid="columns"/> from business_vehicle_model where source_code=#{sourceCode} and dongchedi_car_id=#{carId}</select>
  <select id="selectByLegacyTask" resultMap="Model">select <include refid="columns"/> from business_vehicle_model where source_code=#{sourceCode} and dongchedi_series_id=#{seriesId} and (first_seen_task_id=#{taskId} or last_seen_task_id=#{taskId}) order by id</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into business_vehicle_model(source_code,dongchedi_car_id,dongchedi_series_id,brand_name,series_name,model_name,manufacturer,official_guide_price,level,energy_type,instrument_screen_size_inch,instrument_screen_style,center_screen_size_inch,center_screen_material,passenger_screen_size_inch,rear_screen_size_inch,source_url,field_sources_json,field_status_json,raw_json,first_seen_task_id,last_seen_task_id,first_seen_time,last_crawled_time,create_by,create_time) values(#{sourceCode},#{dongchediCarId},#{dongchediSeriesId},#{brandName},#{seriesName},#{modelName},#{manufacturer},#{officialGuidePrice},#{level},#{energyType},#{instrumentScreenSizeInch},#{instrumentScreenStyle},#{centerScreenSizeInch},#{centerScreenMaterial},#{passengerScreenSizeInch},#{rearScreenSizeInch},#{sourceUrl},#{fieldSourcesJson},#{fieldStatusJson},#{rawJson},#{firstSeenTaskId},#{lastSeenTaskId},#{firstSeenTime},#{lastCrawledTime},#{createBy},sysdate())</insert>
  <update id="update">update business_vehicle_model set dongchedi_series_id=#{dongchediSeriesId},brand_name=#{brandName},series_name=#{seriesName},model_name=#{modelName},manufacturer=#{manufacturer},official_guide_price=#{officialGuidePrice},level=#{level},energy_type=#{energyType},instrument_screen_size_inch=#{instrumentScreenSizeInch},instrument_screen_style=#{instrumentScreenStyle},center_screen_size_inch=#{centerScreenSizeInch},center_screen_material=#{centerScreenMaterial},passenger_screen_size_inch=#{passengerScreenSizeInch},rear_screen_size_inch=#{rearScreenSizeInch},source_url=#{sourceUrl},field_sources_json=#{fieldSourcesJson},field_status_json=#{fieldStatusJson},raw_json=#{rawJson},last_seen_task_id=#{lastSeenTaskId},last_crawled_time=#{lastCrawledTime},update_by=#{updateBy},update_time=sysdate() where id=#{id}</update>
  <update id="updateLastSeen">update business_vehicle_model set last_seen_task_id=#{lastSeenTaskId},last_crawled_time=#{lastCrawledTime},update_by=#{updateBy},update_time=sysdate() where id=#{id}</update>
</mapper>
